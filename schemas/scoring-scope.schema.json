{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OFL scoring scope 0.1.0",
  "description": "Attribution for one measurement, separate from transcript context. This is not a complete results exchange format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope_version", "context", "target", "aggregation", "support", "measurement", "source_evidence"],
  "properties": {
    "scope_version": { "const": "0.1.0" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transcript_ref", "selector"],
      "properties": {
        "transcript_ref": { "$ref": "#/definitions/nonempty_string" },
        "selector": { "$ref": "#/definitions/transcript_selector" }
      }
    },
    "target": { "$ref": "#/definitions/target_selector" },
    "aggregation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "operation", "missing_policy"],
          "properties": {
            "unit": { "const": "target" },
            "operation": { "const": "none" },
            "missing_policy": { "const": "propagate" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "operation", "missing_policy"],
          "properties": {
            "unit": { "const": "turn" },
            "operation": { "enum": ["mean", "sum", "min", "max"] },
            "missing_policy": { "enum": ["propagate", "exclude"] }
          }
        }
      ]
    },
    "support": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "supported" },
            "reason": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "enum": ["unsupported", "unknown"] },
            "reason": { "$ref": "#/definitions/nonempty_string" }
          }
        }
      ]
    },
    "measurement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "missing_reason"],
          "properties": {
            "value": { "type": "number" },
            "missing_reason": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "missing_reason"],
          "properties": {
            "value": { "type": "null" },
            "missing_reason": { "$ref": "#/definitions/nonempty_string" }
          }
        }
      ]
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/nonempty_string" }
    },
    "source_result_ref": { "$ref": "#/definitions/nonempty_string" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "support": {
            "type": "object",
            "properties": { "status": { "enum": ["unsupported", "unknown"] } }
          }
        }
      },
      "then": {
        "properties": {
          "measurement": { "type": "object", "properties": { "value": { "type": "null" } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "aggregation": { "type": "object", "properties": { "unit": { "const": "turn" } } }
        }
      },
      "then": {
        "properties": {
          "target": { "type": "object", "properties": { "kind": { "enum": ["window", "whole_transcript"] } } }
        }
      }
    }
  ],
  "definitions": {
    "nonempty_string": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "turn_index"],
      "properties": {
        "kind": { "const": "turn" },
        "turn_index": { "type": "integer", "minimum": 0 }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "start_turn", "turn_count"],
      "properties": {
        "kind": { "const": "window" },
        "start_turn": { "type": "integer", "minimum": 0 },
        "turn_count": { "type": "integer", "minimum": 1 }
      }
    },
    "whole_transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "whole_transcript" } }
    },
    "extracted_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "turn_index", "start_char", "char_count"],
      "properties": {
        "kind": { "const": "extracted_answer" },
        "turn_index": { "type": "integer", "minimum": 0 },
        "start_char": { "type": "integer", "minimum": 0 },
        "char_count": { "type": "integer", "minimum": 0 }
      }
    },
    "transcript_selector": {
      "oneOf": [
        { "$ref": "#/definitions/turn" },
        { "$ref": "#/definitions/window" },
        { "$ref": "#/definitions/whole_transcript" }
      ]
    },
    "target_selector": {
      "oneOf": [
        { "$ref": "#/definitions/transcript_selector" },
        { "$ref": "#/definitions/extracted_answer" }
      ]
    }
  }
}
